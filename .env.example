# Copy to `.env` and fill in real values. `.env` is git-ignored.
# On Netlify, configure these values in the site's environment variables instead.

# Public site URL, used for the homepage canonical link and social metadata.
# Optional: without it those URLs are omitted. robots.txt and sitemap.xml
# always derive the origin from the request, so they need no configuration.
# VITE_SITE_URL=https://your-site.netlify.app

# Turso / libSQL connection
TURSO_URL=libsql://<database>-<org>.turso.io
TURSO_ACCESS_TOKEN=<token>

# Secret used to encrypt the session cookie. Required, at least 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=<random-secret-min-32-chars>

# Cloudflare R2 (product images). Browser uploads PUT straight to R2, so the
# bucket needs a CORS rule for this app's origin. R2 rejects a wildcard in
# AllowedHeaders — list the header literally:
#   AllowedOrigins: ["http://localhost:3000", "https://your-site.netlify.app"]
#   AllowedMethods: ["GET","PUT"]
#   AllowedHeaders: ["content-type"]   # NOT "*"
#   ExposeHeaders:  ["ETag"]
CLOUDFLARE_ACCOUNT_ID=<account-id>
CLOUDFLARE_BUCKET=<bucket-name>
CLOUDFLARE_ACCESS_KEY_ID=<r2-access-key-id>
CLOUDFLARE_SECRET_KEY=<r2-secret-access-key>
# S3 API endpoint, used for signing uploads and reading images. A trailing
# /<bucket> is tolerated (it is stripped), but the bare endpoint is preferred:
#   https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_S3_URI=https://<account-id>.r2.cloudflarestorage.com
# Optional. Images are read through this app's own /img proxy by default, which
# works even where the public *.r2.dev domain is blocked. Set this only if the
# bucket has a custom domain / CDN you would rather read from:
# CLOUDFLARE_R2_PUBLIC_URL=https://images.example.com

# Xendit payment gateway (QRIS). Test keys start with `xnd_development_`.
# A production key (`xnd_production_…`) is refused unless XENDIT_LIVE=true.
XENDIT_API_KEY=<xendit-secret-key>
# Webhook verification token from Dashboard → Settings → Webhooks
# (sent by Xendit as the `x-callback-token` header).
XENDIT_CALLBACK_TOKEN=<webhook-verification-token>
# Optional API origin override (tests point this at a local fake server).
# XENDIT_BASE_URL=https://api.xendit.co
# Set to true only when the key above is a live production key.
# XENDIT_LIVE=true
