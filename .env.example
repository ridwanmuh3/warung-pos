# Copy to `.env` and fill in real values. `.env` is git-ignored.

# Turso / libSQL connection
TURSO_URL=libsql://<database>-<org>.turso.io
TURSO_ACCESS_TOKEN=<token>

# Secret used to encrypt the session cookie (any long random string)
# Generate with: openssl rand -base64 48
SESSION_SECRET=<random-secret>

# Cloudflare R2 (product images). Browser uploads PUT straight to R2, so the
# bucket needs a CORS rule for this app's origin. R2 rejects a wildcard in
# AllowedHeaders — list the header literally:
#   AllowedOrigins: ["http://localhost:3000"]
#   AllowedMethods: ["GET","PUT"]
#   AllowedHeaders: ["content-type"]   # NOT "*"
#   ExposeHeaders:  ["ETag"]
CLOUDFLARE_ACCOUNT_ID=<account-id>
CLOUDFLARE_BUCKET=<bucket-name>
CLOUDFLARE_ACCESS_KEY_ID=<r2-access-key-id>
CLOUDFLARE_SECRET_KEY=<r2-secret-access-key>
# S3 API endpoint, used for signing uploads: https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_S3_URI=https://<account-id>.r2.cloudflarestorage.com
# Public read base URL (r2.dev dev domain or a custom domain)
CLOUDFLARE_R2_DEV_URL=https://pub-<hash>.r2.dev
